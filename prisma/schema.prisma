enum UserStatus {
  active
  suspended
}

enum RewardStatus {
  active
  redeemed
  expired
}

datasource db {
  //fk it me rendi, no se podia realizar la coneccion con hostinger incluso cambiando los caracteres a Ascii y todo
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  // Cambie user-id a 36 char por los -
  user_id           String    @id @default(uuid()) @db.Char(36)
  // Quite que el email fuera unico igual que la wallet temporalmente para pruebas
  email             String?   @db.VarChar(100)
  name              String    @db.VarChar(100)
  first_name        String?   @db.VarChar(50)
  paternal_surname  String?   @db.VarChar(50)
  maternal_surname  String?   @db.VarChar(50)
  avatar_url        String?   @db.VarChar(2048)
  wallet_address    String?
  age               Int?
  birth_date        DateTime?
  type              String    @db.VarChar(100)
  status            String    @default("active")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  credentials         Credential[]
  auth_identities     AuthIdentity[]
  smart_wallets       SmartWallet[]
  passkey_credentials PasskeyCredential[]
  establishments      Establishment[]
  establishment_rewards EstablishmentReward[]
  rewards             Reward[]
  airdrop_configs     AirdropConfig[]
  posts               Post[]
  charges_created     Charge[] @relation("ChargeAdmin")
  charges_claimed     Charge[] @relation("ChargeClaimant")
  products                 Product[]
  dynamic_participations   PostDynamicParticipation[]
}

model AuthIdentity {
  identity_id      String   @id @default(uuid()) @db.Char(36)
  user_id          String   @db.Char(36)
  provider         String   @db.VarChar(50)
  provider_subject String   @db.VarChar(255)
  email            String?  @db.VarChar(255)
  email_verified   Boolean  @default(false)
  display_name     String?  @db.VarChar(255)
  avatar_url       String?  @db.VarChar(2048)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id])

  @@unique([provider, provider_subject])
  @@index([user_id])
  @@index([email])
}

model SmartWallet {
  wallet_id        String   @id @default(uuid()) @db.Char(36)
  user_id          String   @db.Char(36)
  network          String   @db.VarChar(50)
  contract_address String   @db.VarChar(100)
  status           String   @default("pending") @db.VarChar(50)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user                User                @relation(fields: [user_id], references: [user_id])
  passkey_credentials PasskeyCredential[]

  @@unique([network, contract_address])
  @@unique([user_id, network])
  @@index([user_id])
}

model PasskeyCredential {
  passkey_credential_id String    @id @default(uuid()) @db.Char(36)
  user_id               String    @db.Char(36)
  wallet_id             String?   @db.Char(36)
  credential_id         String    @unique @db.VarChar(512)
  public_key            String    @db.Text
  public_key_algorithm  Int?
  sign_count            BigInt    @default(0)
  transports            Json?
  device_label          String?   @db.VarChar(100)
  last_used_at          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  user   User         @relation(fields: [user_id], references: [user_id])
  wallet SmartWallet? @relation(fields: [wallet_id], references: [wallet_id])

  @@index([user_id])
  @@index([wallet_id])
}

model Post {
  post_id            String    @id @default(uuid()) @db.Char(36)
  author_id          String    @db.Char(36)
  title              String    @db.VarChar(500)
  body               String?   @db.Text
  view_count         Int       @default(0)
  share_count        Int       @default(0)
  content_edited_at  DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  author      User             @relation(fields: [author_id], references: [user_id])
  attachments PostAttachment[]
  dynamics    PostDynamic[]

  @@index([created_at(sort: Desc), post_id(sort: Asc)])
  @@index([author_id, created_at(sort: Desc), post_id(sort: Asc)])
}

model PostAttachment {
  attachment_id String  @id @default(uuid()) @db.Char(36)
  post_id       String  @db.Char(36)
  url           String  @db.VarChar(2048)
  mime_type     String  @db.VarChar(255)
  original_name String? @db.VarChar(255)

  post Post @relation(fields: [post_id], references: [post_id], onDelete: Cascade)

  @@index([post_id])
}

model Credential {
  credential_id String   @id @default(uuid()) @db.Char(36)
  user_id       String   @db.Char(36)
  username      String   @unique @db.VarChar(100)
  password_hash String   @db.VarChar(256)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id])
}

model Establishment {
  establishment_id String   @id @default(uuid()) @db.Char(36)
  admin_id         String   @db.Char(36)
  name             String   @db.VarChar(150)
  address          String?  @db.VarChar(255)
  category         String?  @db.VarChar(100)
  avatar_url       String?  @db.VarChar(2048)
  description      String?  @db.Text
  phone            String?  @db.VarChar(30)
  website          String?  @db.VarChar(255)
  hours            String?  @db.Text
  location_x       Decimal? @db.Decimal(11, 7)
  location_y       Decimal? @db.Decimal(10, 7)
  location_z       Decimal? @db.Decimal(8, 2)
  cashback_percent Int      @default(5)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  admin   User     @relation(fields: [admin_id], references: [user_id])
  rewards Reward[]
  establishment_rewards EstablishmentReward[]
  charges       Charge[]
  products      Product[]
  images        EstablishmentImage[]
  post_dynamics PostDynamic[]
}

model EstablishmentImage {
  image_id         String   @id @default(uuid()) @db.Char(36)
  establishment_id String   @db.Char(36)
  url              String   @db.VarChar(2048)
  sort_order       Int      @default(0)
  created_at       DateTime @default(now())

  establishment Establishment @relation(fields: [establishment_id], references: [establishment_id], onDelete: Cascade)

  @@index([establishment_id, sort_order])
}

model EstablishmentReward {
  establishment_reward_id String   @id @default(uuid()) @db.Char(36)
  establishment_id        String   @db.Char(36)
  admin_id                String   @db.Char(36)
  title                   String   @db.VarChar(150)
  short_description       String   @db.VarChar(255)
  long_description        String?  @db.Text
  image_url               String?  @db.VarChar(2048)
  value_tonkis            Int      @default(0)
  value_usd               Float    @default(0)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  establishment Establishment @relation(fields: [establishment_id], references: [establishment_id])
  admin         User          @relation(fields: [admin_id], references: [user_id])

  @@index([establishment_id])
  @@index([admin_id])
  @@map("Establishment_Reward")
}

model Reward {
  reward_id        String   @id @default(uuid()) @db.Char(36)
  user_id          String   @db.Char(36)
  establishment_id String   @db.Char(36)
  title            String   @db.VarChar(150)
  description      String?
  points           Int      @default(0)
  status           String   @default("active")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user          User          @relation(fields: [user_id], references: [user_id])
  establishment Establishment @relation(fields: [establishment_id], references: [establishment_id])
  charge        Charge?
}

model Charge {
  charge_id          String    @id @default(uuid()) @db.Char(36)
  establishment_id   String    @db.Char(36)
  admin_id           String    @db.Char(36)
  amount             Decimal   @db.Decimal(12, 2)
  cashback_percent   Int
  token              String    @unique @db.VarChar(64)
  expires_at         DateTime
  status             String    @default("pending") @db.VarChar(20)
  claimed_by_user_id String?   @db.Char(36)
  reward_id          String?   @unique @db.Char(36)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  establishment Establishment @relation(fields: [establishment_id], references: [establishment_id])
  admin         User          @relation("ChargeAdmin", fields: [admin_id], references: [user_id])
  claimed_by    User?         @relation("ChargeClaimant", fields: [claimed_by_user_id], references: [user_id])
  reward                 Reward?                    @relation(fields: [reward_id], references: [reward_id])
  line_items             ChargeLineItem[]
  dynamic_participations PostDynamicParticipation[]

  @@index([admin_id, created_at(sort: Desc)])
  @@index([establishment_id])
  @@index([claimed_by_user_id, updated_at(sort: Desc)])
  @@index([establishment_id, status, updated_at(sort: Desc)])
}

model Product {
  product_id       String   @id @default(uuid()) @db.Char(36)
  establishment_id String   @db.Char(36)
  admin_id         String   @db.Char(36)
  name             String   @db.VarChar(150)
  sku              String?  @db.VarChar(64)
  description      String?  @db.VarChar(500)
  unit_price       Decimal  @db.Decimal(12, 2)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishment_id], references: [establishment_id])
  admin         User          @relation(fields: [admin_id], references: [user_id])
  line_items    ChargeLineItem[]

  @@index([establishment_id, is_active, created_at(sort: Desc)])
  @@index([admin_id])
}

model ChargeLineItem {
  line_item_id String   @id @default(uuid()) @db.Char(36)
  charge_id    String   @db.Char(36)
  product_id   String?  @db.Char(36)
  product_name String   @db.VarChar(150)
  quantity     Int      @default(1)
  unit_price   Decimal  @db.Decimal(12, 2)
  created_at   DateTime @default(now())

  charge  Charge   @relation(fields: [charge_id], references: [charge_id], onDelete: Cascade)
  product Product? @relation(fields: [product_id], references: [product_id], onDelete: SetNull)

  @@index([charge_id])
  @@index([product_id])
}

model PostDynamic {
  dynamic_id       String    @id @default(uuid()) @db.Char(36)
  post_id          String    @db.Char(36)
  /// Obligatorio solo en consumo. Tiempo, Voy, código y QR pueden existir sin perfil.
  establishment_id String?   @db.Char(36)
  kind             String    @db.VarChar(20)
  status           String    @default("active") @db.VarChar(20)
  config           Json
  progress_count   Int       @default(0)
  progress_amount  Decimal   @default(0) @db.Decimal(12, 2)
  goal_count       Int?
  starts_at        DateTime?
  ends_at          DateTime?
  closed_at        DateTime?
  /// Token del enlace QR. Único; nulo en los tipos que no son qr.
  token            String?   @unique @db.VarChar(64)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  post           Post                       @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  establishment  Establishment?             @relation(fields: [establishment_id], references: [establishment_id], onDelete: Restrict)
  participations PostDynamicParticipation[]

  @@index([post_id])
  @@index([establishment_id, kind, status])
}

model PostDynamicParticipation {
  participation_id String   @id @default(uuid()) @db.Char(36)
  dynamic_id       String   @db.Char(36)
  user_id          String   @db.Char(36)
  source           String   @db.VarChar(20)
  charge_id        String?  @db.Char(36)
  /// user_id en going, promo_code y qr. Nulo en charge: MySQL admite varios NULL y el mismo cliente puede sumar compras. El cupo de consumo lo cierra (dynamic_id, charge_id).
  person_key       String?  @db.Char(36)
  created_at       DateTime @default(now())

  dynamic PostDynamic @relation(fields: [dynamic_id], references: [dynamic_id], onDelete: Cascade)
  user    User        @relation(fields: [user_id], references: [user_id], onDelete: Restrict)
  charge  Charge?     @relation(fields: [charge_id], references: [charge_id], onDelete: Restrict)

  @@unique([dynamic_id, person_key])
  @@unique([dynamic_id, charge_id])
  @@index([dynamic_id])
  @@index([user_id])
  @@index([charge_id])
}

model AirdropConfig {
  config_id           String    @id @default(uuid()) @db.Char(36)
  user_id             String    @db.Char(36)
  amount              Float
  asset               String    @default("TONKI") @db.VarChar(10)
  scheduled_date      DateTime
  scheduled_end_date  DateTime?
  periodicity_months  Int
  max_users           Int
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user     User                    @relation(fields: [user_id], references: [user_id])
  logs     AirdropLog[]
  archives AirdropCampaignArchive[]
}

model AirdropCampaignArchive {
  archive_id       String   @id @default(uuid()) @db.Char(36)
  config_id        String   @db.Char(36)
  admin_id         String   @db.Char(36)
  establishment_id String?  @db.Char(36)
  campaign_start   DateTime
  campaign_end     DateTime
  balance_sent     Float    @default(0)
  users_sent       Int      @default(0)
  visitors_count   Int      @default(0)
  purchase_count   Int      @default(0)
  total_spent      Float    @default(0)
  archived_at      DateTime @default(now())

  config AirdropConfig @relation(fields: [config_id], references: [config_id], onDelete: Cascade)

  @@unique([config_id])
  @@index([admin_id, campaign_end(sort: Desc)])
}

model AirdropLog {
  log_id           String   @id @default(uuid()) @db.Char(36)
  config_id        String   @db.Char(36)
  transaction_hash String?  @db.VarChar(100)
  total_amount     Float
  users_involved   Int
  executed_at      DateTime @default(now())
  success          Boolean  @default(true)
  error_message    String?  @db.VarChar(255)
  response_json    String?  @db.Text

  config AirdropConfig @relation(fields: [config_id], references: [config_id])
}
